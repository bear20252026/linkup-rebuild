<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The collection card: the location layer's module manifest deliberately carries only fine/coarse;
         background access and the foreground-service permissions arrive here, where the service lives. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:name=".data.LinkUpApplication"
        android:allowBackup="false"
        tools:replace="android:allowBackup"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Watcher">

        <activity
            android:name=".RecoveryProbeActivity"
            android:exported="false" />

        <activity
            android:name=".pages.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Watcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".pages.main.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pages.guide.GuideActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pages.lock.LockListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pages.voice.RealtimeVoiceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pages.shot.ScreenshotActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity android:name=".pages.mine.PermissionListActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".pages.mine.AutoReportSettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".pages.mine.MapSettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".pages.mine.PrivacySettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".pages.mine.DataSecurityActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".pages.mine.AppPswHomeActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".pages.mine.ContactUsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".pages.mine.AboutUsActivity" android:exported="false" android:screenOrientation="portrait" />

        <activity
            android:name=".pages.camera.CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pages.friend.FriendRequestListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pages.friend.FriendRequestDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pages.friend.FriendInfoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pages.friend.MyFriendActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pages.friend.AddFriendActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pages.friend.ContactInfoListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pages.friend.QRCodeScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pages.login.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".pages.login.EmptyLoginActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name=".pages.web.CommonWebActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".pages.track.TrackRecordActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pages.chat.ChatActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <receiver
            android:name=".widget.TrackWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_track_info" />
        </receiver>

        <service
            android:name=".service.TrackCollectService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 原版声明逐字还原：LabelUp 辅助功能，BIND_ACCESSIBILITY_SERVICE，只拿截屏能力。 -->
        <service
            android:name=".service.AppAccessibilityService"
            android:description="@string/accessibility_service_description"
            android:exported="false"
            android:label="LinkUp 辅助功能"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/camera_file_paths" />
        </provider>
    </application>

    <!-- The add-friend screen asks whether WeChat/QQ are installed. On API 30+ that query is only
         answered for packages declared here; the original asked through the SDKs, which declare them
         in their own manifests. -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
    </queries>

</manifest>
