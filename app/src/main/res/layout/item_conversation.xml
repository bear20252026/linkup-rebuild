<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/ic_avatar_male" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_conversation_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/appPrimary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_conversation_last"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/color_7b90b4"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_conversation_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_chat_send"
        android:minWidth="18dp"
        android:paddingHorizontal="5dp"
        android:textColor="@color/white"
        android:textSize="11sp" />
</LinearLayout>
